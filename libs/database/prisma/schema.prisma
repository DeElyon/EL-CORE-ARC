generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// CORE IDENTITY & WALLET
// ============================================

enum UserRole {
  INTERN      // EL ACCESS
  DEVELOPER   // ELCODERS
  CLIENT      // MY SPACE
  COMPANY     // MY SPACE (Startup)
  LEARNER     // ELITES
}

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  username        String    @unique
  passwordHash    String
  role            UserRole  @default(LEARNER)
  verseScore      Int       @default(0)
  isGatedPaid     Boolean   @default(false)
  displayName     String?
  avatarUrl       String?
  bio             String?
  devStreak       Int       @default(0) // Daily sign-in streak
  lastActiveAt    DateTime?
  
  // Financials
  wallet          Wallet?
  
  // App Relations
  posts           Post[]            // NEXEL
  comments        Comment[]         // NEXEL
  projects        Project[]         // ELCODERS / MY SPACE
  internships     Internship[]      // EL ACCESS
  enrollments     Enrollment[]      // ELITES
  certifications  Certification[]   // ELITES
  messages        Message[]         // NEXEL Messenger
  notifications   Notification[]    // Global
  codeSessions    CodeSession[]     // ELCODERS
  liveStreams     LiveStream[]      // NEXEL
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Wallet {
  id              String   @id @default(uuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  wthBalance      Decimal  @default(0) @db.Decimal(18, 8)
  escrowBalance   Decimal  @default(0) @db.Decimal(18, 8)
  transactions    Transaction[]
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

enum TransactionType {
  CREDIT
  DEBIT
  ESCROW_LOCK
  ESCROW_RELEASE
  WITHDRAWAL
  DEPOSIT
  GIFT
  PAYMENT
}

enum AppSource {
  NEXEL
  ELCODERS
  EL_ACCESS
  MY_SPACE
  ELITES
}

model Transaction {
  id            String          @id @default(uuid())
  walletId      String
  wallet        Wallet          @relation(fields: [walletId], references: [id])
  amount        Decimal         @db.Decimal(18, 8)
  type          TransactionType
  appSource     AppSource
  description   String?
  relatedId     String?         // Project ID, Post ID, etc.
  status        String          @default("PENDING") // PENDING, SUCCESS, FAILED
  createdAt     DateTime        @default(now())
}

// ============================================
// NEXEL (Social Media & Marketplace)
// ============================================

enum PostType {
  CONTENT
  PULSE
  MARKETPLACE_ITEM
  VENTURE_PITCH
}

model Post {
  id            String    @id @default(uuid())
  authorId      String
  author        User      @relation(fields: [authorId], references: [id])
  content       String
  mediaUrl      String?   // Photos/Pulse Videos
  type          PostType  @default(CONTENT)
  likesCount    Int       @default(0)
  commentsCount Int       @default(0)
  sharesCount   Int       @default(0)
  viewsCount    Int       @default(0)
  isVerified     Boolean   @default(false)
  hashtags      String[]  @default([])
  
  // Marketplace specific
  price         Decimal?  @db.Decimal(18, 8)
  currency      String?   @default("WTH")
  
  comments      Comment[]
  likes         PostLike[]
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Comment {
  id            String   @id @default(uuid())
  postId        String
  post          Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId      String
  author        User     @relation(fields: [authorId], references: [id])
  content       String
  likesCount    Int      @default(0)
  createdAt     DateTime @default(now())
}

model PostLike {
  id        String   @id @default(uuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  createdAt DateTime @default(now())
  
  @@unique([postId, userId])
}

model LiveStream {
  id            String   @id @default(uuid())
  streamerId    String
  streamer      User     @relation(fields: [streamerId], references: [id])
  title         String
  description   String?
  thumbnailUrl  String?
  isLive        Boolean  @default(true)
  viewersCount  Int      @default(0)
  totalGifts    Decimal  @default(0) @db.Decimal(18, 8)
  startedAt     DateTime @default(now())
  endedAt       DateTime?
}

model Gift {
  id            String   @id @default(uuid())
  streamId      String?
  senderId      String
  receiverId    String
  giftType      String   // "pulse_sparkle", "gold_star", etc.
  amount        Decimal  @db.Decimal(18, 8)
  createdAt     DateTime @default(now())
}

model Message {
  id            String   @id @default(uuid())
  senderId      String
  sender        User     @relation(fields: [senderId], references: [id])
  receiverId    String
  content       String
  isRead        Boolean  @default(false)
  isEncrypted   Boolean  @default(true) // E2EE
  createdAt     DateTime @default(now())
  
  @@index([senderId, receiverId])
}

// ============================================
// ELCODERS (Developer Platform)
// ============================================

enum ProjectStatus {
  OPEN
  ACTIVE
  IN_REVIEW
  COMPLETED
  CANCELLED
}

model Project {
  id              String        @id @default(uuid())
  title           String
  description     String
  budget          Decimal       @db.Decimal(18, 8)
  status          ProjectStatus @default(OPEN)
  clientId        String
  developerId     String?
  client          User          @relation(fields: [clientId], references: [id])
  milestones      Milestone[]
  codeSessions    CodeSession[]
  submissions     Submission[]
  
  // Tech stack
  techStack       String[]
  repositoryUrl   String?
  
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model Milestone {
  id            String   @id @default(uuid())
  projectId    String
  project      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title        String
  description  String
  amount       Decimal   @db.Decimal(18, 8)
  status       String   @default("PENDING") // PENDING, LOCKED, RELEASED
  dueDate      DateTime?
  completedAt  DateTime?
  createdAt    DateTime @default(now())
}

model CodeSession {
  id            String   @id @default(uuid())
  projectId    String
  project      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  developerId  String
  developer    User      @relation(fields: [developerId], references: [id])
  isShadowMode Boolean   @default(false)
  shadowViewers String[] @default([]) // Intern IDs watching
  startedAt    DateTime  @default(now())
  endedAt      DateTime?
}

model Submission {
  id            String   @id @default(uuid())
  projectId    String
  project      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  developerId  String
  title       String
  description  String
  codeUrl      String?   // GitHub PR link
  status       String   @default("PENDING") // PENDING, APPROVED, REJECTED
  aiFeedback   String?   // Lina's pre-check
  reviewedAt   DateTime?
  createdAt    DateTime @default(now())
}

// ============================================
// EL ACCESS (Internship Platform)
// ============================================

model Internship {
  id            String   @id @default(uuid())
  internId      String
  intern        User     @relation(fields: [internId], references: [id])
  title         String
  description   String
  status        String   @default("ACTIVE") // ACTIVE, COMPLETED, TERMINATED
  stipend       Decimal  @default(0) @db.Decimal(18, 8)
  tasks         Task[]
  progress      Int      @default(0) // 0-100
  startedAt     DateTime @default(now())
  completedAt   DateTime?
}

model Task {
  id            String   @id @default(uuid())
  internshipId String
  internship    Internship @relation(fields: [internshipId], references: [id], onDelete: Cascade)
  title         String
  description   String
  hint          String?   // Uno's hint
  status        String   @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED
  dueDate       DateTime
  submittedAt   DateTime?
  createdAt     DateTime @default(now())
}

// ============================================
// MY SPACE (Freelance Marketplace)
// ============================================

enum EntryTier {
  FREELANCER  // 20k NGN
  CLIENT      // 30k NGN
  STARTUP     // 50k NGN
}

model Job {
  id            String   @id @default(uuid())
  title         String
  description   String
  budget        Decimal  @db.Decimal(18, 8)
  clientId      String
  status        String   @default("OPEN") // OPEN, ASSIGNED, IN_PROGRESS, COMPLETED
  techStack     String[]
  aiMatches     String[] @default([]) // Buddy's top 3 developer IDs
  bids          Bid[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Bid {
  id            String   @id @default(uuid())
  jobId         String
  job           Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  developerId   String
  amount        Decimal  @db.Decimal(18, 8)
  proposal      String
  status        String   @default("PENDING") // PENDING, ACCEPTED, REJECTED
  createdAt     DateTime @default(now())
}

model Squad {
  id            String   @id @default(uuid())
  companyId     String
  name          String
  seniorDevId   String
  juniorDevId   String?
  internId      String?
  projectId     String?
  createdAt     DateTime @default(now())
}

// ============================================
// ELITES (Learning Platform)
// ============================================

model Course {
  id            String   @id @default(uuid())
  title         String
  description   String
  instructorId  String
  price         Decimal  @db.Decimal(18, 8)
  difficulty    String   // BEGINNER, INTERMEDIATE, ADVANCED
  category      String
  lessons       Lesson[]
  enrollments   Enrollment[]
  certifications Certification[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Lesson {
  id            String   @id @default(uuid())
  courseId      String
  course        Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title         String
  content       String
  videoUrl      String?
  order         Int
  quiz          Quiz?
  createdAt     DateTime @default(now())
}

model Quiz {
  id            String   @id @default(uuid())
  lessonId      String   @unique
  lesson        Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  questions     Question[]
  passingScore  Int      @default(70)
  createdAt     DateTime @default(now())
}

model Question {
  id            String   @id @default(uuid())
  quizId        String
  quiz          Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  question      String
  options       String[]
  correctAnswer Int
  explanation   String?
  createdAt     DateTime @default(now())
}

model Enrollment {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  courseId      String
  course        Course   @relation(fields: [courseId], references: [id])
  progress      Int      @default(0)
  currentLesson String?
  completedAt   DateTime?
  createdAt     DateTime @default(now())
  
  @@unique([userId, courseId])
}

model Certification {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  courseId      String
  course        Course   @relation(fields: [courseId], references: [id])
  nftHash       String?  // Blockchain certificate hash
  issuedAt      DateTime @default(now())
  
  @@unique([userId, courseId])
}

// ============================================
// GLOBAL NOTIFICATIONS
// ============================================

enum NotificationType {
  PAYMENT
  CODE_REVIEW
  MESSAGE
  PROJECT_UPDATE
  COURSE_COMPLETE
  SYSTEM
}

model Notification {
  id            String           @id @default(uuid())
  userId        String
  user          User             @relation(fields: [userId], references: [id])
  type          NotificationType
  title         String
  message       String
  isRead        Boolean          @default(false)
  relatedId     String?          // Project ID, Post ID, etc.
  appSource     AppSource
  createdAt     DateTime         @default(now())
  
  @@index([userId, isRead])
}
