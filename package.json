{
  "name": "el-verse-backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "start:api": "pnpm --filter ./apps/arc-core-api start",
    "upload-worker": "ts-node -r tsconfig-paths/register libs/shared-utils/upload-worker.ts",
    "queue-worker": "ts-node -r tsconfig-paths/register libs/shared-utils/queue-worker.ts",
    "db:seed": "ts-node -r tsconfig-paths/register libs/database/seed.ts",
    "db:generate": "pnpm --filter ./libs/database exec prisma generate",
    "db:migrate": "pnpm --filter ./libs/database exec prisma migrate dev",
    "db:push": "pnpm --filter ./libs/database exec prisma db push",
    "db:studio": "pnpm --filter ./libs/database exec prisma studio"
  },
  "devDependencies": {
    "@jest/globals": "^30.2.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.0.0",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.6",
    "turbo": "^2.7.3",
    "typescript": "^5.0.0",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0"
  },
  "dependencies": {
    "bullmq": "^5.66.4",
    "ioredis": "^5.3.2",
    "ffmpeg-static": "^5.3.0",
    "prom-client": "^15.1.3",
    "@sentry/node": "^10.32.1",
    "@aws-sdk/client-s3": "^3.965.0",
    "@aws-sdk/s3-request-presigner": "^3.965.0",
    "@google/generative-ai": "^0.24.1",
    "@nestjs/common": "^11.1.11",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.11",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.1.11",
    "@nestjs/platform-socket.io": "^11.1.11",
    "@nestjs/swagger": "^11.2.4",
    "@nestjs/websockets": "^11.1.11",
    "@prisma/client": "^7.2.0",
    "@types/bcrypt": "^6.0.0",
    "bcrypt": "^6.0.0",
    "nodemailer": "^7.0.12",
    "openai": "^6.15.0",
    "prisma": "^7.2.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0",
    "socket.io": "^4.5.0"
  }
}
